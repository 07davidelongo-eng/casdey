# casdey web — environment variables
# Copy to .env.local for local development. Set the same keys in Vercel's
# project settings for preview and production.

# --- Waitlist storage (Supabase, EU region) ---
# Project settings > API. The region must be in the EU: the landing page tells
# gyms their data stays in the UK and the EU.
SUPABASE_URL=

# The service role key (older projects) or secret key (newer projects, sb_secret_...).
# It bypasses row level security, so it is server-only. Never prefix it with
# NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications (Zoho Mail, same credentials as cold outreach) ---
ZOHO_API_DOMAIN=https://mail.zoho.eu
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# Where new-signup alerts go, and what address mail is sent from.
WAITLIST_NOTIFY_TO=info@casdey.com
CASDEY_FROM_ADDRESS=info@casdey.com

# ===========================================================================
# The app at /app. Everything below is only needed once you are running the
# product itself, not the marketing pages.
# ===========================================================================

# --- Supabase Auth (safe to expose, both are RLS-bound) ---
# Same project as SUPABASE_URL above. Use the BARE project URL, not the
# https://<ref>.supabase.co/rest/v1/ one shown on the Data API page: the client
# appends its own path and you get PGRST125 otherwise.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key (older projects) or publishable key (newer, sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (3-tier: Free / Standard / Pro — Track F) ---
# Test keys until there is a real customer. Run `npm run setup:stripe` to create
# the two products (Standard, Pro), all 8 prices, and the 20% coupon, then paste
# the ids it prints. Live prices are created by hand in the dashboard to match
# the script's amounts (it refuses to run on a live key).
#
# Then verify with `npm run check:stripe`, which calls Stripe and confirms every
# id below resolves to a real, active, correctly-priced object in that key's
# mode. Getting one of these wrong is not a loud failure: an unmatched price
# resolves to no tier, and a null tier on an active subscription reads as Pro.
STRIPE_SECRET_KEY=
# 8 price ids: <TIER>_<CURRENCY>_<INTERVAL>. Market is Europe, so EUR is primary.
STRIPE_PRICE_STANDARD_EUR_MONTH=
STRIPE_PRICE_STANDARD_EUR_YEAR=
STRIPE_PRICE_STANDARD_GBP_MONTH=
STRIPE_PRICE_STANDARD_GBP_YEAR=
STRIPE_PRICE_PRO_EUR_MONTH=
STRIPE_PRICE_PRO_EUR_YEAR=
STRIPE_PRICE_PRO_GBP_MONTH=
STRIPE_PRICE_PRO_GBP_YEAR=
# Lifetime early-adopter discount: a single flat 20% percent-off coupon
# (currency-agnostic, both paid tiers). Applied automatically at checkout for
# early-adopter gyms. Replaces the old per-currency STRIPE_COUPON_GBP/EUR,
# which are still read as a fallback if this is unset. Do not set those two:
# they are fixed amounts (£50/€59), which on Standard discount far more than 20%.
STRIPE_COUPON_PERCENT=
# Locally, from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# In production, from the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Google Calendar (booking sync, Settings → Booking) ---
# From the "casdey web" OAuth client in Google Cloud (project casdey-gws-cli,
# owned by info@casdey.com). Redirect URI must include
# https://casdey.com/api/calendar/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Encrypts each gym's calendar tokens at rest. Any long random string, BUT it
# must be byte-identical here and in Vercel: local dev and production share the
# same Supabase database, so a mismatched key shows "Connected" in the UI and
# then silently fails to decrypt tokens the other environment wrote.
CALENDAR_TOKEN_KEY=

# --- Mindbody (direct import; stubbed, no real credentials yet) ---
# Unset is the normal state: the ingestion stub reports "not connected" and CSV
# import stays the real path.
MINDBODY_API_BASE=
MINDBODY_API_KEY=

# --- Offer model (src/lib/plan.ts) ---
# V1 leaves both unset (they default on): new signups get the free week, and
# they are flagged early adopters for the lifetime discount. For V2, set both to
# "false" in Vercel. Existing early adopters keep their discount regardless.
CASDEY_TRIAL_ENABLED=true
CASDEY_EARLY_ADOPTER_DISCOUNT=true

# --- Member email ---
# Optional. Without it, campaign email goes out through the Zoho account above,
# which cannot set a per-gym reply-to (Zoho rejects unverified reply-to
# addresses). With it, a member's reply lands in the gym's own inbox.
# Sending domain is mail.casdey.com (a subdomain, kept separate from Zoho's
# own records on the root casdey.com), verified in Resend.
RESEND_API_KEY=
# Must be on the Resend-verified domain above, or sends will be rejected.
CASDEY_SENDING_ADDRESS=no-reply@mail.casdey.com

# A SECOND Resend key, with Full access. Only Settings -> Sending uses it, to
# register and verify a gym's own domain (Track G1). RESEND_API_KEY above is
# deliberately Sending-access-only and Resend answers 401 restricted_api_key on
# every /domains call with it, so per-gym sending cannot work without this one.
# Kept separate on purpose: the key in the hot send path should not be able to
# delete other gyms' sending domains. Run `npm run check:resend` after setting.
RESEND_ADMIN_API_KEY=

# --- Gym cold outreach (.claude/skills/gym-outreach, not read by the app itself) ---
# Root casdey.com is a SEPARATE Resend-verified domain from mail.casdey.com
# above (added 2026-08-22), specifically so outreach sends as a real person's
# address rather than a subdomain. Same value as Davide's real Zoho inbox by
# design: Resend sends it (SPF/DKIM now authorize both Zoho and Resend/SES to
# send as casdey.com), replies still land in the real Zoho mailbox, so From
# and Reply-To match exactly, which reads as more human, not less.
CASDEY_OUTREACH_SENDING_ADDRESS=davide@casdey.com

# Shared secret for POST /api/cron/send, which drains the send queue. Any long
# random string. On Vercel, set the same value and add a cron entry.
CRON_SECRET=

# Public base URL. Used to build the unsubscribe link in every member email,
# including from the cron job, which has no request to derive an origin from.
# Locally http://localhost:3000, in production https://casdey.com
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp channel (src/lib/whatsapp/, Track E1) ---
# All optional. With none set, the channel degrades to a "disabled" provider:
# Settings -> WhatsApp still saves, but creating or sending a WhatsApp campaign
# errors cleanly. Real prospect sends also need the Twilio account upgraded off
# the trial tier (Content Templates + a custom inbound webhook are both gated).
# The inbound webhook is POST /api/whatsapp/webhook (point Twilio at it).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The shared casdey WhatsApp sender, E.164, no "whatsapp:" prefix.
TWILIO_WHATSAPP_FROM=
# Powers the AI reply loop that answers a member once they reply. Without it,
# inbound opt-out (STOP) and logging still work; the member just gets no
# automated reply.
ANTHROPIC_API_KEY=
# Optional model override for the reply loop. Defaults to Claude Haiku.
CASDEY_WHATSAPP_AI_MODEL=
